  else if(a==='cfno'){U.cf=null}
  else if(a==='recpdfwa'){const x=S.appts.find(q=>q.id===U.rec);if(x){x.pay=U.pay;x.paid=U.rv;pdfRecibo(x,'share');U.rec=null}}
  else if(a==='recchat'){const x=S.appts.find(q=>q.id===U.rec);if(x){x.pay=U.pay;x.paid=U.rv;pdfRecibo(x,'chat');U.rec=null}}
  else if(a==='fc'){U.fc=id}
  else if(a==='fcbg'){if(e.target!==b)return;save();U.fc=null}
  else if(a==='fcx'||a==='fcsave'){save();U.fc=null;if(a==='fcsave')toast('Ficha salva ✓')}
  else if(a==='cfbg'){if(e.target!==b)return;U.cf=null}
  else if(a==='cfok'){const c=U.cf;U.cf=null;U.ok=true;const el=document.createElement('button');el.dataset.a=c.a;if(c.id)el.dataset.id=c.id;document.body.appendChild(el);el.click();el.remove();U.ok=false;return}
  else if(a==='look'){U.lk=true}
  else if(a==='cplink'){try{navigator.clipboard.writeText(PUB).then(()=>toast('Link copiado'),()=>toast('Selecione o link e copie manualmente'))}catch(e){toast('Selecione o link e copie manualmente')}return}
  else if(a==='splt'){const p=S.pros.find(x=>x.id===id);p.split=!p.split;if(p.split){if(p.end>'12:00'){p.e2=p.end>'14:00'?p.end:'18:00';p.s2='14:00';p.end='12:00'}}else p.end=p.e2||p.end;save()}
  else if(a==='rmlogo'){S.biz.logo='';save()}
  else if(a==='addcli'){const c={id:'c'+uid(),name:'Novo cliente',phone:'',notes:''};S.clients.unshift(c);U.cid=c.id;save()}
  else if(a==='delcli'){if(!U.ok){U.cf={m:'Excluir esta cliente? O histórico de agendamentos continua registrado.',a,id};render();return}S.clients=S.clients.filter(x=>x.id!==id);U.cid=null;save()}
  else if(a==='mon'){U.cm+=+b.dataset.d;if(U.cm<0){U.cm=11;U.cy--}if(U.cm>11){U.cm=0;U.cy++}}
  else if(a==='sel')U.sel=id;
  else if(a==='st'){const x=S.appts.find(q=>q.id===id);x.status=b.dataset.s;save();if(x.status==='confirmado'){toast('Confirmado. Abrindo o WhatsApp da cliente…');window.open(wa(x),'_blank','noopener')}else toast({cancelado:'Cancelado',concluido:'Atendimento concluído',pendente:'Reaberto'}[x.status])}
  else if(a==='addsvc'){S.svcs.push({id:'s'+uid(),name:'Novo procedimento',dur:30,price:50});save()}
  else if(a==='delsvc'){if(!U.ok){U.cf={m:'Excluir este procedimento? As profissionais deixam de oferecê-lo.',a,id};render();return}S.svcs=S.svcs.filter(x=>x.id!==id);S.pros.forEach(p=>delete p.svc[id]);save()}
  else if(a==='addpro'){S.pros.push({id:'p'+uid(),name:'Nova profissional',start:'09:00',end:'18:00',days:[1,2,3,4,5],svc:{}});save()}
  else if(a==='delpro'){if(!U.ok){U.cf={m:'Excluir esta profissional?',a,id};render();return}S.pros=S.pros.filter(x=>x.id!==id);save()}
  else if(a==='day'){const p=S.pros.find(x=>x.id===id),d=+b.dataset.d;p.days=p.days.includes(d)?p.days.filter(x=>x!==d):[...p.days,d].sort();save()}
  else if(a==='reset'){if(!U.ok){U.cf={m:'Apagar tudo e voltar aos dados de exemplo?',a,id};render();return}S=seed();fix();save()}
  render();
});
document.addEventListener('input',e=>{const f=e.target.dataset.f;if(f==='name')U.name=e.target.value;if(f==='phone'){U.phone=e.target.value}if(f==='q'){U.q=e.target.value;$('#cl').innerHTML=cList()}if(f==='rv'){U.rv=Math.max(0,+e.target.value||0);const ra=S.appts.find(x=>x.id===U.rec);if(ra)$('#rcp').innerHTML=rcPrev(ra)}if(f==='af'&&U.af)U.af[e.target.dataset.k]=e.target.type==='checkbox'?e.target.checked:e.target.value;if(f==='ln')U.ln=e.target.value;if(f==='fprod'||f==='fobs'){const fx=S.appts.find(q=>q.id===U.fc);if(fx)fx[f==='fprod'?'prod':'obs']=e.target.value}if(f==='lp')U.lp=e.target.value;});
document.addEventListener('change',e=>{
  const t=e.target,f=t.dataset.f;if(!f||f==='name'||f==='phone'||f==='q'||f==='ln'||f==='lp'||f==='rv'||f==='fprod'||f==='fobs'||f==='af')return;
  if(f==='pay'){U.pay=t.value;render();return}
  if(f==='mes'){U.mes=t.value||U.mes;render();return}
  if(f==='logo'){const fl=t.files[0];if(!fl)return;const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const s=Math.min(1,256/Math.max(im.width,im.height)),w=Math.max(1,Math.round(im.width*s)),h=Math.max(1,Math.round(im.height*s)),c=document.createElement('canvas');c.width=w;c.height=h;c.getContext('2d').drawImage(im,0,0,w,h);S.biz.logo=c.toDataURL('image/png');S.biz.lw=w;S.biz.lh=h;save();toast('Logo atualizada');render()};im.onerror=()=>toast('Não foi possível ler essa imagem.');im.src=r.result};r.readAsDataURL(fl);return}
  const id=t.dataset.id,k=t.dataset.k;
  if(f==='svc'){const s=S.svcs.find(x=>x.id===id);s[k]=k==='name'?t.value:Math.max(0,+t.value||0)}
  else if(f==='pro'){S.pros.find(x=>x.id===id)[k]=t.value}
  else if(f==='prosvc'){const p=S.pros.find(x=>x.id===id),s=S.svcs.find(x=>x.id===t.dataset.s);if(t.checked)p.svc[s.id]=s.dur;else delete p.svc[s.id]}
  else if(f==='produr'){const p=S.pros.find(x=>x.id===id);p.svc[t.dataset.s]=Math.max(5,+t.value||5)}
  else if(f==='biz'){S.biz[k]=t.value}
  else if(f==='cli'){S.clients.find(x=>x.id===id)[k]=t.value}
  else if(f==='cfg'){S.cfg[k]=k==='auto'?t.value==='1':+t.value}
  save();if(f==='prosvc')render();if(f==='biz'){const bz=S.biz;$('#brand').innerHTML=(bz.logo?`<img class="bl" src="${bz.logo}" alt="">`:'<i></i>')+esc(bz.name||'Salão');document.title=(bz.name||'Salão')+' – Agendamento'}
});
function boot(){U.in=sess.get()&&!!(getAcc()&&getAcc().ok);const pub=location.hash==='#agendar';if(pub)U.view='cliente';document.querySelector('nav').hidden=pub;render()}
document.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.dataset&&e.target.dataset.f==='af'&&e.target.type!=='checkbox'){const b=document.querySelector('.auth .btn');if(b)b.click()}});
addEventListener('hashchange',boot);boot();
</script>
</body>
