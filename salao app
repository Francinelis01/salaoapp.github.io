<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ateliê Lúmen – Agendamento</title>
<meta name="description" content="Sistema de agendamento para salão de beleza">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&display=swap">
<style>
:root{--bg:#f6f3fa;--sf:#fff;--ink:#2a1b3d;--mut:#6d6280;--ln:#e4dcef;--ac:#c2487a;--ac2:#fbe6ef;--ok:#2f7d62;--ok2:#dff1ea;--wn:#9a6b00;--wn2:#fbf0d2;--no:#a33;--no2:#f8e0e0;color-scheme:light;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#17101f;--sf:#221a2d;--ink:#f1eaf8;--mut:#a99bbd;--ln:#392d49;--ac:#e8749f;--ac2:#3b2030;--ok:#6fd0ad;--ok2:#1b3a30;--wn:#e8c15a;--wn2:#3a3216;--no:#f08a8a;--no2:#3d2020;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#17101f;--sf:#221a2d;--ink:#f1eaf8;--mut:#a99bbd;--ln:#392d49;--ac:#e8749f;--ac2:#3b2030;--ok:#6fd0ad;--ok2:#1b3a30;--wn:#e8c15a;--wn2:#3a3216;--no:#f08a8a;--no2:#3d2020;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.5 "Bricolage Grotesque",system-ui,sans-serif}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--ac);outline-offset:2px}
header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px clamp(16px,4vw,40px);border-bottom:1px solid var(--ln);background:var(--sf);position:sticky;top:env(safe-area-inset-top,0px);z-index:5}
.brand{font-weight:800;font-size:1.35rem;letter-spacing:-.02em}
.brand i{display:inline-block;width:.8em;height:.8em;border-radius:50% 50% 50% 0;background:var(--ac);margin-right:8px;transform:rotate(-45deg)}
nav{display:flex;gap:4px;background:var(--bg);padding:4px;border-radius:99px}
nav button{border:0;background:none;padding:8px 16px;border-radius:99px;font-weight:600;color:var(--mut)}
nav button.on{background:var(--ink);color:var(--bg)}
main{max-width:1080px;margin:0 auto;padding:clamp(16px,4vw,40px)}
h1{font-size:clamp(2rem,5vw,3.2rem);line-height:1.05;letter-spacing:-.03em;margin:0 0 8px;font-weight:800}
h2{font-size:1.15rem;margin:0 0 12px;font-weight:700}
.sub{color:var(--mut);margin:0 0 28px;max-width:52ch}
.card{background:var(--sf);border:1px solid var(--ln);border-radius:20px;padding:20px;margin-bottom:16px}
.grid{display:grid;gap:10px;grid-template-columns:repeat(auto-fill,minmax(210px,1fr))}
.opt{text-align:left;background:var(--sf);border:1.5px solid var(--ln);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:2px}
.opt:hover{border-color:var(--ac)}
.opt.on{border-color:var(--ac);background:var(--ac2)}
.opt b{font-weight:600}.opt small{color:var(--mut)}
.opt:disabled{opacity:.4;cursor:not-allowed}
.days{display:flex;gap:8px;overflow-x:auto;padding-bottom:8px}
.day{min-width:62px;text-align:center;border:1.5px solid var(--ln);background:var(--sf);border-radius:14px;padding:8px 4px;flex:none}
.day span{display:block;font-size:.75rem;color:var(--mut)}.day b{font-size:1.25rem}
.day.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}.day.on span{color:inherit}
.day:disabled{opacity:.35;cursor:not-allowed}
.slots{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.slot{border:1.5px solid var(--ln);background:var(--sf);border-radius:99px;padding:7px 16px;font-weight:600}
.slot.on{background:var(--ac);border-color:var(--ac);color:#fff}
.btn{border:0;background:var(--ac);color:#fff;font-weight:700;padding:12px 22px;border-radius:99px}
.btn.alt{background:var(--bg);color:var(--ink);border:1px solid var(--ln)}
.btn.sm{padding:6px 14px;font-size:.88rem}
.btn.ok{background:var(--ok)}.btn.no{background:var(--no2);color:var(--no)}
.btn:disabled{opacity:.4;cursor:not-allowed}
label{display:block;font-size:.88rem;color:var(--mut);margin-bottom:4px}
input,select,textarea{width:100%;border:1.5px solid var(--ln);background:var(--bg);border-radius:12px;padding:10px 12px;resize:vertical}
.row{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(160px,1fr))}
.sum{background:var(--ac2);border-radius:14px;padding:14px;margin:16px 0}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
.tabs button{border:1px solid var(--ln);background:var(--sf);padding:8px 18px;border-radius:99px;font-weight:600}
.tabs button.on{background:var(--ac);border-color:var(--ac);color:#fff}
.bd{background:var(--wn2);color:var(--wn);border-radius:99px;padding:0 8px;font-size:.8rem;margin-left:6px}
.split{display:grid;gap:20px;grid-template-columns:minmax(280px,360px) 1fr}
@media(max-width:760px){.split{grid-template-columns:1fr}}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;text-align:center}
.cal .h{font-size:.75rem;color:var(--mut);padding:4px 0}
.cal button{aspect-ratio:1;border:0;background:none;border-radius:12px;position:relative;font-weight:600}
.cal button:hover{background:var(--bg)}
.cal button.on{background:var(--ink);color:var(--bg)}
.cal button.td{box-shadow:inset 0 0 0 2px var(--ac)}
.cal button em{position:absolute;bottom:4px;left:50%;transform:translateX(-50%);width:6px;height:6px;border-radius:50%;background:var(--ok);font-style:normal}
.cal button em.p{background:var(--wn)}
.cm{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;font-weight:700;text-transform:capitalize}
.cm button{border:0;background:var(--bg);width:34px;height:34px;border-radius:50%}
.ap{display:flex;gap:14px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:14px 0;border-bottom:1px solid var(--ln)}
.ap:last-child{border:0}
.ap .t{font-weight:800;font-size:1.2rem;min-width:56px}
.ap .i{flex:1;min-width:160px}.ap small{color:var(--mut)}
.chip{font-size:.78rem;font-weight:700;border-radius:99px;padding:2px 10px}
.chip.pendente{background:var(--wn2);color:var(--wn)}.chip.confirmado{background:var(--ok2);color:var(--ok)}.chip.cancelado{background:var(--no2);color:var(--no)}
.er{display:grid;gap:10px;grid-template-columns:2fr 1fr 1fr auto;align-items:end;margin-bottom:12px}
@media(max-width:640px){.er{grid-template-columns:1fr 1fr}}
.pro{border:1px solid var(--ln);border-radius:16px;padding:16px;margin-bottom:14px;background:var(--sf)}
.dw{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0}
.dw button{border:1.5px solid var(--ln);background:none;border-radius:99px;padding:4px 12px;font-weight:600}
.dw button.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.ps{display:grid;grid-template-columns:auto 1fr 110px;gap:10px;align-items:center;padding:6px 0}
.ps input[type=checkbox]{width:20px;height:20px;accent-color:var(--ac)}
.ps input[type=number]{padding:6px 10px}
.empty{color:var(--mut);padding:24px;text-align:center}
.done{text-align:center;padding:40px 20px}
.done h1{font-size:2rem}
#toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 20px;border-radius:99px;opacity:0;pointer-events:none;transition:opacity .2s;z-index:9}
#toast.on{opacity:1}
.kpis{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));margin-bottom:16px}
.kpi{background:var(--sf);border:1px solid var(--ln);border-radius:20px;padding:16px 18px}
.kpi b{display:block;font-size:1.7rem;letter-spacing:-.02em;line-height:1.2}.kpi span{color:var(--mut);font-size:.88rem}
.split2{display:grid;gap:16px;grid-template-columns:3fr 2fr}
@media(max-width:760px){.split2{grid-template-columns:1fr}}
.lg{display:flex;gap:16px;font-size:.85rem;color:var(--mut);margin-top:6px}.lg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px}
.tp{margin-bottom:12px}.tp div{display:flex;justify-content:space-between;font-size:.92rem}.tp u{display:block;height:8px;border-radius:99px;background:var(--ac);margin-top:4px}
.btn.wa{background:#178a45;text-decoration:none;display:inline-block}
.chip.concluido{background:var(--ac2);color:var(--ac)}
.cl{display:flex;flex-direction:column;gap:6px;max-height:520px;overflow:auto;margin-top:12px}
.cl button{text-align:left;border:1.5px solid var(--ln);background:var(--sf);border-radius:12px;padding:10px 12px}
.cl button.on{border-color:var(--ac);background:var(--ac2)}.cl small{display:block;color:var(--mut)}
.bl{height:32px;width:auto;max-width:90px;object-fit:contain;vertical-align:middle;margin-right:8px;border-radius:6px}
.logo{width:96px;height:96px;border:2px dashed var(--ln);border-radius:16px;display:grid;place-items:center;color:var(--mut);font-size:.85rem;flex:none;overflow:hidden}.logo img{max-width:100%;max-height:100%}
.lnk{border:0;background:none;color:var(--ac);font-weight:600;text-decoration:underline;padding:4px}
.al{border-radius:12px;padding:10px 14px;margin-bottom:14px;font-size:.92rem}
.al.no{background:var(--no2);color:var(--no)}.al.ok{background:var(--ok2);color:var(--ok)}.al.wn{background:var(--wn2);color:var(--wn)}
nav[hidden]{display:none}
.rc{border:1px solid var(--ln);border-radius:14px;padding:16px;margin:12px 0;background:var(--bg);font-size:.92rem}
.rh{display:flex;gap:10px;align-items:center;justify-content:space-between;border-bottom:2px solid var(--ac);padding-bottom:10px;margin-bottom:10px}
.rc small{display:block;color:var(--mut)}
.ov{position:fixed;inset:0;background:rgba(20,10,30,.5);display:grid;place-items:center;padding:16px;z-index:20}
.md{background:var(--sf);border-radius:20px;padding:24px;width:min(520px,100%);max-height:92vh;overflow:auto}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header>
  <div class="brand" id="brand"></div>
  <nav aria-label="Modo"><button data-a="view" data-v="cliente">Agendar</button><button data-a="view" data-v="painel">Painel</button><button data-a="logout" id="out" hidden>Sair</button></nav>
</header>
<main id="app"></main>
<div id="toast" role="status"></div>
<script>
const $=s=>document.querySelector(s);
const DN=['dom','seg','ter','qua','qui','sex','sáb'],DF=['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
const iso=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const pd=s=>{const[a,b,c]=s.split('-');return new Date(+a,+b-1,+c)};
const tm=t=>{const[h,m]=t.split(':');return +h*60+ +m};
const hm=n=>String(Math.floor(n/60)).padStart(2,'0')+':'+String(n%60).padStart(2,'0');
const brl=n=>(+n||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const uid=()=>Math.random().toString(36).slice(2,8);
const today=()=>iso(new Date());
const addD=(n)=>{const d=new Date();d.setDate(d.getDate()+n);return iso(d)};

function hist(){const N=[['Camila Souza','(86) 99999-1234'],['Bianca Lima','(86) 98888-4321'],['Joana Alves','(86) 97777-1111'],['Paula Reis','(86) 96666-2222']],X=[['s1','p1','Corte feminino','Marina',60,90],['s3','p1','Coloração','Marina',150,220],['s2','p3','Escova','Rafael',30,60],['s5','p2','Manicure','Letícia',45,40],['s4','p1','Hidratação profunda','Marina',60,110],['s6','p2','Design de sobrancelhas','Letícia',30,45]],o=[];for(let i=1;i<=14;i++)for(let j=0;j<1+i%3;j++){const x=X[(i+j*2)%6],n=N[(i+j)%4];o.push({id:'h'+i+'_'+j,sid:x[0],pid:x[1],sn:x[2],pn:x[3],date:addD(-i),time:hm(540+j*120),dur:x[4],price:x[5],name:n[0],phone:n[1],status:'concluido'})}o.push({id:'h_old',sid:'s3',pid:'p1',sn:'Coloração',pn:'Marina',date:addD(-44),time:'10:00',dur:150,price:220,name:'Renata Prado',phone:'(86) 95555-3333',status:'concluido',prod:'Coloração 7.1 + oxigenada 20 vol',obs:'Prefere tom mais frio'});return o}
function seed(){return{
 cfg:{step:30,auto:false},
 svcs:[{id:'s1',name:'Corte feminino',dur:60,price:90},{id:'s2',name:'Escova',dur:45,price:60},{id:'s3',name:'Coloração',dur:120,price:220},{id:'s4',name:'Hidratação profunda',dur:60,price:110},{id:'s5',name:'Manicure',dur:45,price:40},{id:'s6',name:'Design de sobrancelhas',dur:30,price:45}],
 pros:[
  {id:'p1',name:'Marina',start:'09:00',end:'18:00',days:[2,3,4,5,6],svc:{s1:60,s2:45,s3:150,s4:60}},
  {id:'p2',name:'Letícia',start:'10:00',end:'19:00',days:[1,2,3,4,5],svc:{s5:45,s6:30}},
  {id:'p3',name:'Rafael',start:'12:00',end:'20:00',days:[2,3,4,5,6],svc:{s1:45,s2:30,s3:120}}],
 appts:[
  {id:'a1',sid:'s1',pid:'p1',sn:'Corte feminino',pn:'Marina',date:addD(1),time:'10:00',dur:60,name:'Camila Souza',phone:'(86) 99999-1234',status:'pendente'},
  {id:'a2',sid:'s5',pid:'p2',sn:'Manicure',pn:'Letícia',date:addD(1),time:'14:30',dur:45,name:'Bianca Lima',phone:'(86) 98888-4321',status:'confirmado'},{id:'a3',sid:'s2',pid:'p3',sn:'Escova',pn:'Rafael',date:today(),time:'16:00',dur:30,name:'Joana Alves',phone:'(86) 97777-1111',status:'confirmado'},{id:'a4',sid:'s4',pid:'p1',sn:'Hidratação profunda',pn:'Marina',date:today(),time:'11:00',dur:60,name:'Paula Reis',phone:'(86) 96666-2222',status:'pendente'},...hist()]}}
let S;
try{S=JSON.parse(localStorage.getItem('lumen')||'null')}catch(e){S=null}
if(!S)S=seed();
const save=()=>{try{localStorage.setItem('lumen',JSON.stringify(S));return true}catch(e){return false}};
const dg=s=>String(s||'').replace(/\D/g,'');
function fix(){S.clients=S.clients||[];S.svcs.forEach(s=>{if(s.ret==null)s.ret=({s1:60,s3:45,s4:30,s5:15})[s.id]||0});S.cfg.lead=S.cfg.lead??7;S.biz=Object.assign({name:'Ateliê Lúmen',owner:'',doc:'',phone:'',addr:'',logo:'',lw:1,lh:1},S.biz||{});S.appts.forEach(a=>{if(!a.cid)a.cid=upClient(a.name,a.phone).id})}
function upClient(name,phone){let c=S.clients.find(x=>dg(x.phone)===dg(phone));if(!c){c={id:'c'+uid(),name,phone,notes:''};S.clients.push(c)}return c}
fix();
const price=a=>a.paid??a.price??(S.svcs.find(s=>s.id===a.sid)||{}).price??0;
const rcv=a=>U.rec===a.id?U.rv:price(a);
const LB={pendente:'pendente',confirmado:'confirmado',cancelado:'cancelado',concluido:'concluído'};
const wa=a=>{let n=dg(a.phone);if(n.length<=11)n='55'+n;const d=pd(a.date).toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long'});const m='Olá, '+a.name.split(' ')[0]+'! Seu horário no '+(S.biz.name||'salão')+' está confirmado ✅\n\n'+a.sn+' com '+a.pn+'\n'+d+', às '+a.time+'\nValor: '+brl(price(a))+'\n\nSe precisar remarcar, é só responder esta mensagem.';return 'https://wa.me/'+n+'?text='+encodeURIComponent(m)};
function acts(a){const b=(s,l,c)=>`<button class="btn sm ${c}" data-a="st" data-id="${a.id}" data-s="${s}">${l}</button> `;if(a.status==='cancelado')return b('pendente','Reabrir','alt');let h='';if(a.status==='pendente')h+=b('confirmado','Confirmar','ok');if(a.status==='confirmado')h+=`<a class="btn sm wa" href="${wa(a)}" target="_blank" rel="noopener">WhatsApp</a> `+b('concluido','Concluir','alt');if(a.status==='confirmado'||a.status==='concluido')h+=`<button class="btn sm alt" data-a="fc" data-id="${a.id}">Ficha</button> `;if(a.status==='concluido')h+=`<button class="btn sm alt" data-a="rec" data-id="${a.id}">Recibo</button>`;if(a.status!=='concluido')h+=b('cancelado','Cancelar','no');return h}
const now=new Date();
const U={view:'cliente',tab:'inicio',au:'login',ae:'',ai:'',af:{},in:false,fails:0,lockUntil:0,cid:null,q:'',rec:null,pay:'Pix',rv:0,ct:'novo',ln:'',lp:'',lk:false,mes:today().slice(0,7),sid:null,pid:null,date:null,time:null,name:'',phone:'',done:null,cy:now.getFullYear(),cm:now.getMonth(),sel:today()};

function slots(p,s,date){
  const dur=p.svc[s.id];if(!dur)return[];
  const d=pd(date);if(!p.days.includes(d.getDay()))return[];
  const step=+S.cfg.step,out=[],R=ranges(p);
  const busy=S.appts.filter(a=>a.pid===p.id&&a.date===date&&a.status!=='cancelado');
  const nowM=date===today()?new Date().getHours()*60+new Date().getMinutes():-1;
  for(const[r0,r1]of R)for(let t=tm(r0);t+dur<=tm(r1);t+=step){
    if(t<=nowM)continue;
    if(busy.some(a=>t<tm(a.time)+a.dur&&tm(a.time)<t+dur))continue;
    out.push(hm(t));
  }
  return out;
}
const toast=m=>{const t=$('#toast');t.textContent=m;t.classList.add('on');clearTimeout(toast.h);toast.h=setTimeout(()=>t.classList.remove('on'),2200)};

function renderClient(){const tb=`<div class="tabs"><button class="${U.ct==='meus'?'':'on'}" data-a="ct" data-id="novo">Agendar</button><button class="${U.ct==='meus'?'on':''}" data-a="ct" data-id="meus">Meus agendamentos</button></div>`;return tb+(U.ct==='meus'?renderMeus():renderClient0())}
function renderClient0(){
  if(U.done){const a=U.done;return`<div class="card done"><h1>${a.status==='confirmado'?'Horário confirmado!':'Pedido enviado!'}</h1><p class="sub" style="margin:0 auto 20px">${esc(a.sn)} com ${esc(a.pn)}, ${pd(a.date).toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long'})} às ${a.time}.<br>${a.status==='confirmado'?'Esperamos você no salão.':'O salão vai confirmar seu horário em breve.'}</p><button class="btn" data-a="again">Fazer outro agendamento</button></div>`}
  const s=S.svcs.find(x=>x.id===U.sid),p=S.pros.find(x=>x.id===U.pid);
  let h=`<h1>Agende seu horário</h1><p class="sub">Escolha o procedimento, a profissional e o melhor horário. Leva menos de um minuto.</p>`;
  h+=`<div class="card"><h2>1. Procedimento</h2><div class="grid">`+(S.svcs.length?S.svcs.map(x=>{const ds=S.pros.map(q=>q.svc[x.id]).filter(Boolean);return`<button class="opt ${x.id===U.sid?'on':''}" data-a="sid" data-id="${x.id}" ${ds.length?'':'disabled'}><b>${esc(x.name)}</b><small>${ds.length?`${Math.min(...ds)}${Math.max(...ds)>Math.min(...ds)?'–'+Math.max(...ds):''} min · `:'Indisponível · '}${brl(x.price)}</small></button>`}).join(''):'<div class="empty">Nenhum procedimento cadastrado.</div>')+`</div></div>`;
  if(s){const ps=S.pros.filter(q=>q.svc[s.id]);
    h+=`<div class="card"><h2>2. Profissional</h2><div class="grid">`+ps.map(q=>`<button class="opt ${q.id===U.pid?'on':''}" data-a="pid" data-id="${q.id}"><b>${esc(q.name)}</b><small>${q.svc[s.id]} min · ${q.days.map(d=>DN[d]).join(', ')}</small></button>`).join('')+`</div></div>`}
  if(s&&p){
    h+=`<div class="card"><h2>3. Data e horário</h2><div class="days">`;
    for(let i=0;i<21;i++){const d=addD(i),dt=pd(d),ok=slots(p,s,d).length>0;h+=`<button class="day ${d===U.date?'on':''}" data-a="date" data-id="${d}" ${ok?'':'disabled'}><span>${DN[dt.getDay()]}</span><b>${dt.getDate()}</b><span>${dt.toLocaleDateString('pt-BR',{month:'short'})}</span></button>`}
    h+=`</div>`;
    if(U.date){const sl=slots(p,s,U.date);h+=`<div class="slots">`+(sl.length?sl.map(t=>`<button class="slot ${t===U.time?'on':''}" data-a="time" data-id="${t}">${t}</button>`).join(''):'<span class="empty">Sem horários neste dia.</span>')+`</div>`}
